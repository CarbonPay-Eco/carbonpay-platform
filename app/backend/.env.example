# Application
NODE_ENV=development
PORT=3000
SERVER_PORT=3000

# Database Configuration
# Set USE_LOCAL_DB=true to use SQLite (local file database - recommended for development)
# Set USE_LOCAL_DB=false to use PostgreSQL (remote/docker)
USE_LOCAL_DB=true

# PostgreSQL Configuration (only used if USE_LOCAL_DB=false)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=carbonpay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=carbonpay
POSTGRES_PORT=5432

# Solana Configuration
SOLANA_NETWORK=localnet
SOLANA_PROGRAM_ID=bGiephq1pZ8kxJVumdgCMEa2BjCEJuviCSwHgL9rdfg
SOLANA_RPC_URL=http://127.0.0.1:8899
SOLANA_SERVER_PRIVATE_KEY=your_base58_encoded_private_key_here
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

